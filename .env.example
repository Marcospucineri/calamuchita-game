# Copiá este archivo como .env (no se sube a git) y completá los valores.
# Conexión a MongoDB Atlas para las anotaciones del modo debug. Sin esto se guardan en notes/anotaciones.json.
MONGODB_URI=
# Clave para usar el modo debug y la API de notas. En Railway es obligatoria; en local es opcional.
DEBUG_TOKEN=

# Supabase (claves públicas del proyecto; NUNCA usar service_role en VITE_*).
# Ejecutar supabase/migrations/202610160001_progress.sql antes de habilitar cuentas.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Opcional: solo para herramientas administrativas locales (nunca se incluye en el juego).
SUPABASE_SECRET_KEY=
# También se aceptan VITE_SUPABASE_URL y VITE_SUPABASE_ANON_KEY.
# GA4: identificador del flujo web, por ejemplo G-XXXXXXXXXX.
VITE_GA_MEASUREMENT_ID=
