{
  "name": "calamuchita-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "data": "node tools/fetch-data.mjs",
    "world": "node tools/build-world.mjs",
    "preview-map": "node tools/preview-map.mjs",
    "test:physics": "node tools/test-physics.mjs",
    "start": "node server.mjs",
    "notes": "node --env-file-if-exists=.env tools/notes.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "mongodb": "^6.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=20"
  }
}
